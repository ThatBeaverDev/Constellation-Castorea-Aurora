#! /System/apps/compilers/js

async function init(args) {
    try {
        if (args[0] == undefined) {
            args[0] = "root"
        }

        const users = await call.read("/System/users.json")
        const user = args[0]

        // make sure user exists
        if (users[user] !== undefined) {
            if (users[user].password == undefined) {
                throw new Error(`User ${user} does not have a password, login denied.`)
                return
            }
        } else {
            std.out = `su - User '${user}' does not exist.`
            return
        }

        try {
            const passwd = await parent.changeUser(user);
            std.out = "Password:"
        } catch (e) {
            std.out = `Password:\n[ERR]${e}`;
            return
        }

    } catch (e) {
        std.out += "\n" + e;
    }
}