function removeQuotes(string, quotes = '"') {
	let str = String(string)
	if (str[0] == quotes) {
		str = str.substring(1, Infinity)
	}

	if (str.at(-1) == quotes) {
		str = str.substring(0, str.length - 1)
	}

	return str
}

function insureQuotes(string, quotes = '"') {
	let str = String(string)
	if (str[0] !== quotes) {
		str = quotes + str
	}

	if (str.at(-1) !== quotes) {
		str = str + quotes
	}

	return str
}

const argsReducer = `const getArgs = (args) => args.reduce((args, arg) => {\n\tif (arg.slice(0, 2) === "--") {\n\t\t// specific values\n\t\tconst longArg = arg.split("=");\n\t\tconst longArgFlag = longArg[0].slice(2);\n\t\tconst longArgValue = longArg.length > 1 ? longArg[1] : true;\n\t\targs[longArgFlag] = longArgValue;\n\t} else if (arg[0] === "-") {\n\t\t// flags\n\t\tconst flags = arg.slice(1).split("");\n\t\tflags.forEach((flag) => {\n\t\t\targs[flag] = true;\n\t\t});\n\t} else {\n\t\t// text data\n\t\targs.data.push(arg);\n\t}\n\treturn args;\n}, {data: []});\nconst ARGUEMENTS = getArgs(args);\nif (ARGUEMENTS.data == undefined) {\n\tARGUEMENTS.data = [];\n};`

const data =  {
	others: {
		pre: "const YAKlocal = {};\n\n" + argsReducer + "\n\nasync function init(YAKVARIABLEargs) {",
		post: "}",
		variable: (VARNAME) => {
			return `YAKlocal['${VARNAME.substring(1)}']`
		},
		scopedVariable: (VARNAME) => {
			return "YAKVARIABLE" + VARNAME.substring(1)
		},
		number: (VALUE) => {
			return VALUE
		},
		string: (VALUE) => {
			return VALUE
		},
		array: (VALUE) => {
			return VALUE
		},
		object: (VALUE) => {
			return VALUE
		},
		boolean: (VALUE) => {
			switch (VALUE) {
				case "TRUE":
					return "true"
				case "FALSE":
					return "false"
				default:
					console.warn(VALUE);
					return undefined
			}
		},
		"not defined": () => "undefined"
	},
	functions: {
		BA: (VALUE) => {
			return `console.log(${VALUE})`
		},

		ARGS: "ARGUEMENTS",

		// VARIABLES
		"VAR:SET": (VARNAME, VALUE) => {
			return `${VARNAME} = ${VALUE}`
		},
		"VAR:LET": (VARNAME, VALUE) => {
			return `let ${VARNAME} = ${VALUE}`
		},
		"VAR:CONST": (VARNAME, VALUE) => {
			return `const ${VARNAME} = ${VALUE}`
		},

		"VAR:ADD": (VARNAME, VALUE) => {
			return `${VARNAME} += ${VALUE}`
		},
		"VAR:MINUS": (VARNAME, VALUE) => {
			return `${VARNAME} -= ${VALUE}`
		},
		"VAR:MULT": (VARNAME, VALUE) => {
			return `${VARNAME} *= ${VALUE}`
		},
		"VAR:DIV": (VARNAME, VALUE) => {
			return `${VARNAME}/+= ${VALUE}`
		},

		// standard input / output
		"STD:OUT": "std.out",
		"STD:IN": "std.in",

		// OPERATORS
		"OP:ADD": (...VALUES) => {
			return VALUES.join(" + ")
		},
		"OP:MINUS": (...VALUES) => {
			return VALUES.join(" - ")
		},
		"OP:MULT": (...VALUES) => {
			return VALUES.join(" * ")
		},
		"OP:DIV": (...VALUES) => {
			return VALUES.join(" / ")
		},

		"OP:MOD": (VALUE1, VALUE2) => {
			return `mod(${VALUE1},${VALUE2})`
		},
		"OP:ABS": (VALUE) => {
			return `Math.abs(${VALUE})`
		},

		"OP:SIN": (VALUE) => {
			return `Math.sin(${VALUE})`
		},
		"OP:COS": (VALUE) => {
			return `Math.cos(${VALUE})`
		},
		"OP:TAN": (VALUE) => {
			return `Math.tan(${VALUE})`
		},

		"OP:TERNARY": (BOOLEAN, VALUE1, VALUE2) => {
			return `${BOOLEAN} ? ${VALUE1} : ${VALUE2}`
		},

		"OP:ASIN": (VALUE) => {
			return `Math.asin(${VALUE})`
		},
		"OP:ACOS": (VALUE) => {
			return `Math.acos(${VALUE})`
		},
		"OP:ATAN": (VALUE) => {
			return `Math.atan(${VALUE})`
		},

		"OP:SQR": (VALUE) => {
			return `${VALUE} ** 2`
		},
		"OP:SQRT": (VALUE) => {
			return `Math.sqrt(${VALUE})`
		},
		"OP:EXP": (VALUE1, VALUE2) => {
			return `${VALUE1} ** ${VALUE2})`
		},
		"OP:FLOOR": (VALUE) => {
			return `Math.floor(${VALUE})`
		},
		"OP:CEIL": (VALUE) => {
			return `Math.ceil(${VALUE})`
		},
		"OP:ROUND": (VALUE) => {
			return `Math.round(${VALUE})`
		},
		"OP:TRNC": (VALUE) => {
			return `Math.trunc(${VALUE})`
		},

		"OP:AND": (VALUE1, VALUE2) => {
			return `${VALUE1} && ${VALUE2}`
		},
		"OP:OR": (VALUE1, VALUE2) => {
			return `${VALUE1} || ${VALUE2}`
		},

		"OP:NOT": (VALUE) => {
			return `!(${VALUE})`
		},

		"OP:TYPE": (VALUE) => {
			return `typeof ${VALUE}`
		},

		"OP:EQUL": (VALUE1, VALUE2) => {
			return `${VALUE1} == ${VALUE2}`
		},
		"OP:DIFF": (VALUE1, VALUE2) => {
			return `${VALUE1} != ${VALUE2}`
		},

		"OP:GREATER": (VALUE1, VALUE2) => {
			return `${VALUE1} > ${VALUE2}`
		},
		"OP:LESS": (VALUE1, VALUE2) => {
			return `${VALUE1} < ${VALUE2}`
		},
		"OP:GREATER-EQ": (VALUE1, VALUE2) => {
			return `${VALUE1} >= ${VALUE2}`
		},
		"OP:LESS-EQ": (VALUE1, VALUE2) => {
			return `${VALUE1} <= ${VALUE2}`
		},

		MAIN: "}\n\nfunction frame() {",

		// static values
		"VAL:PI": "Math.PI",
		"VAL:E": "Math.E",
		"VAL:DATE": "Date.now()",
		"TRUE": "true",
		"FALSE": "false",

		// libraries
		IMPORT: (name) => {
			return `const ${removeQuotes(name)} = new Function("const local = {};\\n" + csw.lib(${name}.yakl.js"))()`;
		},

		IF: (CONDITION) => {
			return `if (${CONDITION}) {`
		},
		ELSE: `} else {`,
		ELSEIF: (CONDITION) => {
			return `} else if (${CONDITION}) {`
		},

		END: "}",

		WHILE: (CONDITION) => {
			return `while (${CONDITION}) {`
		},

		REPEAT: (VALUE) => {
			return `for (let i = 0; i < ${VALUE}; i++) {`
		},

		WITH: (LOOPVAR, VALUE) => {
			return `for (const ${LOOPVAR} in ${VALUE}) {`
		},

		SWITCH: (VALUE) => {
			return `switch (${VALUE}) {`
		},
		CASE: (VALUE) => {
			return `case ${VALUE}:`
		},
		DEFAULT: "default:",

		EXIT: "break",
		PASS: "continue",

		// Functions

		"FUNC:DEF": (VALUE1, ...VALUE2) => {
			return `local.functions[${insureQuotes(VALUE1)}] = async function (${VALUE2.join(", ")}) {`
		},
		"FUNC:CALL": (VALUE1, ...VALUE2) => {
			return `await local.functions[${insureQuotes(VALUE1)}] (${VALUE2})`
		},

		RETURN: (VALUE = "") => {
			return `return ${VALUE}`
		},

		// ARRAYS
		ARR: (VALUE) => {
			return `Array(...${VALUE})`
		},
		"ARR:SORT": (VALUE) => {
			return `${VALUE}.sort()`
		},
		"ARR:JOIN": (VALUE, JOINER) => {
			return `Array(...${VALUE}).join(${JOINER})`
		},
		"ARR:APPEND": (ARRAY, VALUE) => {
			return `${ARRAY}.push(${VALUE})`
		},

		// OBJECTS
		"OBJ:KEY": (VAR, KEY) => {
			return `${VAR}[${KEY}]`
		},
		PARENT: (KEY) => {
			return `parent[${KEY}]`
		},

		// STRINGS
		STR: (STRING) => `String(${STRING})`,
		"STR:LENGTH": (STRING) => {
			return `${STRING}.length`
		},
		"STR:PADSTART": (STRING, LENGTH, PADDER) => {
			return `String(${STRING}).padStart(${LENGTH}, ${PADDER})`
		},
		"STR:PADEND": (STRING, LENGTH, PADDER) => {
			return `String(${STRING}).padEnd(${LENGTH}, ${PADDER})`
		}
	}
};

for (const i in calls) {
	const call = String(calls[i])
	data.functions["SYS:" + call.toUpperCase()] = (...args) => {
		return "await call." + call + "(" + args.join(", ") + ")";
	}
};

return data;