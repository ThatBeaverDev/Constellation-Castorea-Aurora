#! /System/apps/compilers/js

// yak programming language

async function compile(code, targetLanguage = "js") {
	// code gets provided 'code' and 'safe'

	console.time("yakCompile")

	let done
	try {

		yak = await start(targetLanguage)
		yak.code = code


		const src = (code || codee)

		const tokeniser = await call.read("/System/apps/utils/yak/tokeniser");
		const tokeniserFunction = Function(tokeniser);

		const tokenise = tokeniserFunction()

		const tokens = tokenise(src.replaceAll("\t", "    "))

		const compiled = []

		for (const i in tokens) {
			compiled[i] = compileBit(tokens[i])
		}

		let varData = ""
		for (const i in yak.variables) {
			varData += `let YAKVARIABLE${yak.variables[i]};\n`
		}

		done = `//SSM_COMPILED_RESULT\nlocal.functions = {};\n\n${varData}\n\n${yak.others.pre}${compiled.join("\n")}\n\n${yak.others.post}`;
	} catch (e) {
		std.out = "[ERR]" + e.stack
		console.error(e)
	}

	console.timeEnd("yakCompile");
	console.debug("Compilation of YAK code finished.");

	return done
}

function compileBit(array) {
	const arr = structuredClone(array);

	const cmd = String(arr[0]);

	if (cmd.substring(0, 2) == "//" || array.length == 0) {
		return "";
	}

	arr.splice(0, 1);

	const args = [];

	for (const i in arr) {
		const inp = arr[i]
		let comp
		if (typeof inp == "object") {
			comp = compileBit(inp)
		} else {
			comp = compileToken(inp)
		}

		args.push(comp)
	}

	if (yak.functions[cmd] == undefined) {
		throw new Error(`Command '${cmd}' is not a valid yak command.
			
		yakSRC:
		${yak.code}`)
	}

	switch (typeof yak.functions[cmd]) {
		case "function":
			return yak.functions[cmd](...args)
		case "string":
			return yak.functions[cmd]
		default:
			throw new Error(`Compilation Error: error with type of command ${cmd}`)
	}
}

function compileToken(token) {
	const type = typeOfToken(token)

	if (type == "code") {
		return compileBit(token)
	} else if (type == undefined) {
		throw new Error("Syntax Error: undefined is not a valid token type - have you forgotten some quotation marks or brackets around a command? Token in question: " + token)
	} else {
		return yak.others[type](token)
	}
}

function typeOfToken(token) {

	if (["TRUE", "FALSE"].includes(token)) {
		return "boolean"
	}

	if (token == "UNDEFINED") {
		return "not defined"
	}

	if (typeof token == "object") {
		return "code"
	}

	if (token[0] == "$") {
		return "variable"
	}

	if (token[0] == "#") {
		return "scopedVariable"
	}

	if (token[0] = '"' && token.at(-1) == '"') {
		return "string"
	}

	if (token[0] == "{" && token.at(-1) == "}") {
		return "object"
	}

	if (token[0] == "[" && token.at(-1) == "]") {
		return "array"
	}

	if (!isNaN(Number(token))) {
		return "number"
	}
	return undefined;
}


async function start(lang = "js") {
	const file = await call.read("/System/apps/utils/yak/languages/" + lang + ".yakLang");

	const func = Function("calls", file);

	const calls = Object.keys(call);

	const data = func(calls);

	return {
		...data,
		variables: []
	};
};

// yak command line
async function init(args) {
	switch (args[0]) {
		case "compile":

			yak = await start()

			let code = await call.read(args[1]).split("\n")
			if (code[0].substring(0, 2) == "#!") {
				delete code[0]
			}

			code = code.join("\n")

			const directory = await cliCompile(code, args[2])

			std.out += `Compilation complete, output placed in ${directory}`
			break;
		default:
			std.out += `yak command line
options:
    - compile: compiles a .yak script to JavaScript, where it can be ran.
    - lib: compiles libraries so they are up to date and all available. should be ran after installing any modules.`
	}
}

async function cliCompile(src, output = "compilation.js") {
	console.time("yakCompile")
	const code = String(src)

	const dir = await call.fullDirectory(output, parent.dir)

	const compiled = compile(code)

	await call.write(dir, compiled)

	console.timeEnd("yakCompile")

	return dir
}

function reverse(string) {
	return String(string).split("\n").reverse().join("")
}

function getFileExtension(dir) {
	const index = dir.lastIndexOf(".")
	const extension = dir.substring(index, Infinity)
	return extension
}

function getOnlyName(dir) {
	const index = dir.lastIndexOf(".")
	const name = dir.substring(0, index)
	return name
}

