#! /System/apps/compilers/yak

// credit where credit is due, https://github.com/kddnewton/tree/blob/main/tree.js

FUNC:DEF "WALK" #directory #prefix #maxDepth #depth
	IF (OP:GREATER #depth #maxDepth)
		VAR:ADD (STD:OUT) #depth
		VAR:ADD (STD:OUT) #maxDepth
		RETURN
	END


	VAR:CONST #contents (SYS:READDIR #directory)

	ARR:SORT #contents

	WITH #i #contents
		VAR:SET #file (OBJ:KEY #contents #i)
		IF (OP:OR (OP:DIFF (OBJ:KEY #file 0) ".") (OBJ:KEY $OBJ "showhidden"))
			VAR:SET #parts (OP:TERNARY (OP:EQUL (OP:MINUS (OBJ:KEY #contents "length") 1) #i) ["└── ", "    "] ["├── ", "│   "])

			VAR:SET #dispFile (STR #file)

			VAR:CONST #asDir (SYS:FULLDIRECTORY #file #directory)

			IF (OBJ:KEY $OBJ "fullDir")
				VAR:SET #dispFile #asDir
			END

			IF (SYS:ISDIR #asDir)
				BA #asDir
				VAR:ADD (STD:OUT) (OP:ADD #prefix (OP:ADD (OBJ:KEY #parts 0) (OP:ADD #dispFile "\n")))
				VAR:ADD (OBJ:KEY $counts "dirs") 1
				FUNC:CALL "WALK" #asDir (OP:ADD #prefix (OBJ:KEY #parts 1)) #maxDepth (OP:ADD #depth 1)
			ELSE
				IF (OP:NOT (OBJ:KEY $OBJ "dirOnly"))
					VAR:ADD (STD:OUT) (OP:ADD #prefix (OP:ADD (OBJ:KEY #parts 0) (OP:ADD #dispFile "\n")))
				END
				VAR:ADD (OBJ:KEY $counts "files") 1
			END
		END
	END
END

VAR:SET $dir (PARENT "dir")
VAR:SET $OBJ {}

// loop through parameters
WITH #i #args
	SWITCH (OBJ:KEY #args #i)
		CASE "-L"
			VAR:ADD #i 1
			VAR:SET (OBJ:KEY $OBJ "maxLevels") (OBJ:KEY #args $i)
			EXIT
		CASE "-f"
			VAR:SET (OBJ:KEY $OBJ "fullDir") TRUE
			EXIT
		CASE "-d"
			VAR:SET (OBJ:KEY $OBJ "dirOnly") TRUE
			EXIT
		CASE "-a"
			VAR:SET (OBJ:KEY $OBJ "showHidden") TRUE
			EXIT
		DEFAULT
			// if the token is the first one, it's the directory
			IF (OP:DIFF (OBJ:KEY (OBJ:KEY #args #i) 0) "-")
				VAR:SET $dir (SYS:FULLDIRECTORY (OBJ:KEY #args #i) (PARENT "dir"))
			ELSE
				VAR:ADD (STD:OUT) (OP:ADD "[WRN]Unknown flag: " (OBJ:KEY #args #i))
			END
	END
END

VAR:SET $counts {}
VAR:SET (OBJ:KEY $counts "dirs") 0
VAR:SET (OBJ:KEY $counts "files") 0

VAR:SET $directory (STR $dir)
VAR:ADD (STD:OUT) (OP:ADD $directory "\n")

FUNC:CALL "WALK" $directory "" (OBJ:KEY $OBJ "maxLevels") 1

VAR:SET $MSG "Tree Generated for "
VAR:ADD $MSG (OBJ:KEY $counts "dirs")
VAR:ADD $MSG " directories, "
VAR:ADD $MSG (OBJ:KEY $counts "files")
VAR:ADD $MSG " files"

VAR:ADD (STD:OUT) $MSG