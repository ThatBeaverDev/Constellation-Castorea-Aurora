#! /usr/bin/node

async function init(args) {
    const config = await call.read("/etc/pgext.json")

    if (parent.name == "/bin/aquila.js") {
        // CLI mode

        switch (args[0]) {
            case "mode":
                config.mode = args[1]
                break;
            default:
                std.out += "Options are as follows:\n- mode\n"
        }

        system.stopProcess(PID)
        return
    }

    // Service mode (background process)

    if (config == undefined) {
        const cfg = {}
        cfg.mode = "processes"

        call.write("/etc/pgext.json", cfg)
    }

    local.hostname = await call.gethostname()

    local.config = await call.read("/etc/pgext.json");
    setInterval(async () => {
        local.config = await call.read("/etc/pgext.json");
    }, 5000)
}

async function frame() {
    const config = local.config

    let ending

    switch(config.mode) {
        case "processes":
            const processesList = await call.readdir("/proc");
            ending = " (" + processesList.length + " tasks)"
            break;
    }

    const targetTitle = local.hostname + ending;

    if (document.title !== targetTitle) {
        document.title = targetTitle;
    };
}