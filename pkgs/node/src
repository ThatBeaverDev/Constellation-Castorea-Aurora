// /usr/bin/node

// code gets provided 'dir' and 'safe'
let script = code

if (!script.includes("function init(")) {
    script = "function init() {\n" + script + "\n}"
}

if (system.forceSystemLog) {
	if (system.systemWrapper) {
		script = script.replaceAll("console.log(", "csw.console.log(Name,")
		script = script.replaceAll("console.post(", "csw.console.post(Name,")
		script = script.replaceAll("console.warn(", "csw.console.warn(Name,")
		script = script.replaceAll("console.error(", "csw.console.error(Name,")
		script = script.replaceAll("console.edit(", "csw.console.edit(Name,")

		for (const i in csw.functions) {
			script = script.replaceAll(csw.functions[i] + "(", csw.functions[i] + "(token,")
		}
	} else {
		script = script.replaceAll("console.log(", "system.log(Name,")
		script = script.replaceAll("console.post(", "system.post(Name,")
		script = script.replaceAll("console.warn(", "system.warn(Name,")
		script = script.replaceAll("console.error(", "system.error(Name,")
		script = script.replaceAll("console.edit(", "system.editLog(Name,")
	}
}

return script