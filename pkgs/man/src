#! /System/apps/compilers/js

async function exit(reason) {
    if (reason !== undefined) {
        std.out = reason
    }
    local.stopped = true
    await call.kill(".")
}

async function init(args) {

    local.mandir = "/System/apps/data/manpages"

    local.manPageDir = local.mandir + "/" + args[0] + ".1"
    local.manPage = await call.read(local.manPageDir)

    if (local.manPage == undefined) {
        exit(`${args[0]} has no manpage, sorry.`)
        return
    }

    // remove all lines starting with "//"
    const manpage = local.manPage.split("\n")
    let result = []
    for (const i in manpage) {
        if (manpage[i].substring(0, 2) !== "//") {
            result.push(manpage[i])
        }
    }
    local.manPage = result.join("\n")

    local.keys = {}
    local.shortcuts = {}
    local.shortcuts.q = "Quit"

    // sieze the screen
    csw.display.fullscreen(PID)

    csw.display.set(PID, local.manPage)
}

function frame() {
    if (local.manPage == undefined) {
        exit(`${args[0]} has no manpage, sorry.`)
    }

    if (local.stopped) {
        exit()
        return
    }
    const system = csw.permissions.elevate()

    const keys = Object.keys(local.shortcuts)
    for (const i in keys) {
        const key = keys[i]

        if (system.keys[key]) {
            if (!local.keys[key]) {
                switch(key) {
                    case "q":
                        exit()
                        break;
                }
            }
            local.keys[key] = true
        } else {
            local.keys[key] = false
        }
    }
}